# Copy to .env and fill in. .env is git-ignored; never commit a key.

# --- required for `enrich` (the paid step). `pull`/`classify` run without it ---
ANTHROPIC_API_KEY=sk-ant-...

# --- optional ---
# Website search. Without it the domain is guessed from the company name.
SERPER_API_KEY=
# Which seller profile to use (profiles/<name>.toml)
GRIZLY_PROFILE=peakflow
# Extraction model and do-not-guess site audit model
GRIZLY_MODEL=sonnet
GRIZLY_VERIFY_MODEL=opus
# Companies in parallel. 3 is safe; raise only if the server has spare CPU.
GRIZLY_WORKERS=3
# Hard cap per company in USD (extraction / audit separately)
GRIZLY_BUDGET=0.15
GRIZLY_VERIFY_BUDGET=0.30
# Dates in the CSV
TZ=Europe/Prague
# Image build
CLAUDE_CODE_VERSION=2.1.330
